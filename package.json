{
  "name": "@ekubo/sdk",
  "version": "0.0.10",
  "private": false,
  "description": "Shared math and protocol encoding utilities for Ekubo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EkuboProtocol/typescript-sdk.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir dist --format esm --sourcemap && tsc -b tsconfig.src.json",
    "prepublishOnly": "rm -rf dist && bun run build",
    "check-ts": "tsc -b",
    "lint": "bun scripts/lint.ts",
    "lint:prune": "bun scripts/lint.ts --prune",
    "fix": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "files": [
    "dist"
  ],
  "author": "Ekubo Inc <eng@ekubo.org>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.3",
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "@typescript/native": "npm:typescript@^7",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004"
  }
}
